<!DOCTYPE html>
<html lang="zh-CN"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= page.title %></title>
<style>
body{font-family:ui-sans-serif,system-ui,"PingFang SC",sans-serif;background:#101014;color:#f2f1ec;
  max-width:720px;margin:0 auto;padding:40px 20px;line-height:1.7}
a{color:#e6b877}h1{font-size:28px}img{max-width:100%}
nav{margin-bottom:32px;font-size:14px;color:#9c99a8}
.item{padding:10px 0;border-bottom:1px solid #26262f}
</style></head><body>
<nav>🌙 <b><%= site.title %></b> · <%= site.subtitle %> —— <i>主题未加载（fallback）</i></nav>
<h1><%= page.title %></h1>
<% if (page.posts) { %><div>
  <% page.posts.forEach(p => { %><div class="item"><a href="<%= url_for(p.path) %>"><%= p.title %></a>
  <span style="color:#6b6878;font-size:12px"><%= date(p.date) %></span></div><% }) %>
</div><% } else { %>
<div><%- page.content %></div>
<%- page.comments_html || '' %>
<% } %>
<footer style="margin-top:48px;color:#6b6878;font-size:12px">© <%= year %> <%= site.author %> · Moonpress</footer>
</body></html>
