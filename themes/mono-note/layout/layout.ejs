<!DOCTYPE html>
<html lang="zh-CN"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= page.title %></title>
<meta name="description" content="<%= page.description || site.description || site.subtitle %>">
<link rel="alternate" type="application/rss+xml" href="<%= url_for('feed.xml') %>">
<link rel="stylesheet" href="<%= url_for('css/mono-note.css') %>">
<% if (theme.accent) { %><style>:root{--accent:<%= theme.accent %>}</style><% } %>
</head><body>
<pre class="term-head"><span class="prompt">$</span> <span class="cmd">cat /etc/motd</span>
 ╔══════════════════════════════════════════╗
 ║  <b><%= site.title %></b>
 ║  <span class="dim"><%= site.subtitle %></span>
 ╚══════════════════════════════════════════╝</pre>
<nav class="tnav">
  <a href="<%= url_for('/') %>">[ 首页 ]</a>
  <a href="<%= url_for('archives/') %>">[ 归档 ]</a>
  <a href="<%= url_for('about/') %>">[ 关于 ]</a>
  <a href="<%= url_for('feed.xml') %>">[ RSS ]</a>
</nav>
<main class="tmain">
<%- body %>
</main>
<footer class="tfoot">
 ── © <%= year %> <%= site.author %> ── powered by moonpress ── exit(0)
</footer>
</body></html>
